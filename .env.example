# Local development without Compose (still run inside Docker, see README).
# Tenant binding – one container serves exactly one customer.
TENANT_ID=acme
TENANT_NAME=Acme Corp
KIBANA_SPACE_ID=acme
TENANT_AGENT_POLICY_IDS=acme-workstations,acme-servers
TENANT_NAMESPACES=acme
# ALERTS_INDEX=.alerts-security.alerts-acme   # default derived from KIBANA_SPACE_ID

# mock | elastic
DATA_SOURCE=mock
# ELASTICSEARCH_URL=https://es01:9200
# KIBANA_URL=https://kibana:5601
# ELASTIC_API_KEY_FILE=/run/secrets/elastic_api_key   # tenant-specific, read-only
# ELASTIC_TIMEOUT_MS=10000

# Sign-in at the lab's Acme Kanidm (scripts/lab-init.sh, docker compose up -d idm-acme)
ORIGIN=http://localhost:5173
OIDC_ISSUER=https://idm-acme.localhost:8443/oauth2/openid/portal-acme
OIDC_CLIENT_ID=portal-acme
OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
OIDC_REQUIRED_GROUP=portal_users@idm-acme.localhost
NODE_EXTRA_CA_CERTS=/run/secrets/idm-tls/ca.pem
SESSION_SECRET_FILE=/run/secrets/session_secret
# SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
